# Azure Foundry is the default setup. Supply your own credentials below.
# For local model processing instead, set AI_PROVIDER=ollama.
AI_PROVIDER=azure-foundry
# Use the deployment name from Foundry, which may differ from the model name.
AZURE_OPENAI_RESPONSES_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TIMEOUT_SECONDS=240
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama integration (fully offline, no API key). Set AI_PROVIDER=ollama to
# enable genuine natural-language analysis, code generation, real test execution,
# and automatic error-driven correction using a model you run locally.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=240

# Local generated-project workspace. Keep it outside source control in production.
WORKSPACE_ROOT=workspace
# Local SQLite queue/history (one application worker per database).
RUN_DATABASE=data/coderbuddy.sqlite3
